# MongoDB Atlas — Prisma 6.x
# Required query params for serverless (Vercel):
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/rentmycar-prod?retryWrites=true&w=majority"
#
# Atlas → Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
# Vercel has no fixed IPs, so this is required for production.

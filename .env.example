# Prisma ORM 6.x + MongoDB
#
# Local / Compass (SRV is fine):
# DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/rentmycar-prod?retryWrites=true&w=majority"
#
# Vercel (prefer NON-SRV — avoids serverless DNS/TLS failures):
# Atlas → Connect → Drivers → copy the standard connection string (not mongodb+srv),
# or build it like:
# DATABASE_URL="mongodb://USER:PASS@ac-XXXX-shard-00-00.xxxxx.mongodb.net:27017,ac-XXXX-shard-00-01.xxxxx.mongodb.net:27017,ac-XXXX-shard-00-02.xxxxx.mongodb.net:27017/rentmycar-prod?ssl=true&replicaSet=atlas-XXXX-shard-0&authSource=admin&retryWrites=true&w=majority"
#
# Required: Atlas → Network Access → Allow Access from Anywhere (0.0.0.0/0)
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/rentmycar-prod?retryWrites=true&w=majority"

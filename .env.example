# Prisma ORM 6.x + MongoDB (Prisma 7+ has no MongoDB connector)
#
# Atlas (replica set by default — needed for $transaction):
# DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/rentmycar?retryWrites=true&w=majority"
#
# Local replica set via docker compose:
DATABASE_URL="mongodb://127.0.0.1:27017/rentmycar?replicaSet=rs0&directConnection=true"

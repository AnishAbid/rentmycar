// RentMyCar domain model — MongoDB via Prisma ORM 6.x
// Money fields are integer minor units (cents) for the launch currency.
// Note: Prisma 7 has no MongoDB connector — stay on latest 6.x.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RENTER
  OPS
  ADMIN
}

enum UserStatus {
  ACTIVE
  FLAGGED
  BANNED
}

enum AccountKind {
  INDIVIDUAL
  COMPANY
}

enum ContractType {
  REVENUE_SHARE
  FIXED_LEASE
  HYBRID
}

enum VehicleStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  LIVE
  PAUSED
  BOOKED
  MAINTENANCE
  CLAIM
  WITHDRAWN
}

enum VehicleLocation {
  WITH_OWNER
  DEPOT
  WITH_CLIENT
  WITH_VALET
  WORKSHOP
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum DocumentType {
  REGISTRATION
  OWNERSHIP_PROOF
  FITNESS
  INSURANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_CONFIRMATION
  DECLINED
  EXPIRED
  CONFIRMED
  ACTIVE
  RETURNED
  COMPLETED
  CANCELLED
  CLAIM
}

enum ChecklistType {
  PICKUP
  RETURN
}

enum PhotoKind {
  EXTERIOR_FRONT
  EXTERIOR_BACK
  EXTERIOR_LEFT
  EXTERIOR_RIGHT
  INTERIOR
  ODOMETER
  FUEL
  DAMAGE
  OTHER
}

enum PaymentKind {
  TRIP
  DEPOSIT
  EXTRA_CHARGE
  REFUND
  GOODWILL
}

enum PaymentStatus {
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  RELEASED
  FAILED
  CANCELLED
}

enum LedgerType {
  TRIP_GROSS
  PLATFORM_FEE
  OWNER_SHARE
  DEPOSIT_HOLD
  DEPOSIT_CAPTURE
  DEPOSIT_RELEASE
  EXTRA_CHARGE
  REFUND
  GOODWILL
  PAYOUT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  DENIED
  SETTLED
  CLOSED
}

enum TicketStatus {
  OPEN
  PENDING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  email               String      @unique
  name                String?
  passwordHash        String?
  role                Role
  accountKind         AccountKind @default(INDIVIDUAL)
  companyName         String?
  companyRegistration String?
  status              UserStatus  @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  ownerProfile  OwnerProfile?
  renterProfile RenterProfile?

  bookingsAsRenter Booking[]       @relation("RenterBookings")
  assignedBookings Booking[]       @relation("OpsAssignedBookings")
  supportTickets   SupportTicket[] @relation("TicketRequester")
  assignedTickets  SupportTicket[] @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  auditLogs        AuditLog[]
  payoutsCreated   PayoutBatch[]   @relation("PayoutBatchCreator")
}

model OwnerProfile {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  userId           String       @unique @db.ObjectId
  user             User         @relation(fields: [userId], references: [id])
  phone            String?
  payoutMethodHint String?
  bankAccountLast4 String?
  contractType     ContractType @default(REVENUE_SHARE)
  ownerShareBps    Int          @default(7000)
  onboardingDone   Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vehicles Vehicle[]
  payouts  Payout[]
}

model RenterProfile {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  phone           String?
  dateOfBirth     DateTime?
  licenseNumber   String?
  licenseCountry  String?
  licenseImageUrl String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Vehicle {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  ownerId        String          @db.ObjectId
  owner          OwnerProfile    @relation(fields: [ownerId], references: [id])
  status         VehicleStatus   @default(DRAFT)
  location       VehicleLocation @default(WITH_OWNER)
  make           String
  model          String
  year           Int
  plate          String
  vin            String?
  category       String
  seats          Int             @default(5)
  transmission   Transmission    @default(AUTOMATIC)
  fuelType       FuelType        @default(PETROL)
  featuresJson   String          @default("[]")
  dailyRateCents Int
  mileageCapKm   Int?
  maxTripDays    Int?
  city           String
  rejectionNote  String?
  pauseReason    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  photos    VehiclePhoto[]
  documents VehicleDocument[]
  blocks    VehicleBlock[]
  bookings  Booking[]
  claims    Claim[]
}

model VehiclePhoto {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String   @db.ObjectId
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  url       String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VehicleDocument {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId  String         @db.ObjectId
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id])
  type       DocumentType
  url        String
  status     DocumentStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model VehicleBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String   @db.ObjectId
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Booking {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  code               String        @unique
  status             BookingStatus @default(PENDING_CONFIRMATION)
  vehicleId          String        @db.ObjectId
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id])
  renterId           String        @db.ObjectId
  renter             User          @relation("RenterBookings", fields: [renterId], references: [id])
  assignedOpsId      String?       @db.ObjectId
  assignedOps        User?         @relation("OpsAssignedBookings", fields: [assignedOpsId], references: [id])
  startAt            DateTime
  endAt              DateTime
  softHoldExpiresAt  DateTime?
  dailyRateCents     Int
  days               Int
  baseCents          Int
  feesCents          Int           @default(0)
  taxCents           Int           @default(0)
  totalCents         Int
  depositCents       Int
  ownerShareBps      Int
  platformFeeBps     Int
  pickupInstructions String?
  returnInstructions String?
  cancelReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  addons     BookingAddon[]
  checklists TripChecklist[]
  payments   Payment[]
  ledger     LedgerEntry[]
  claim      Claim?
  tickets    SupportTicket[]
}

model BookingAddon {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String  @db.ObjectId
  booking     Booking @relation(fields: [bookingId], references: [id])
  code        String
  label       String
  amountCents Int
}

model TripChecklist {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String        @db.ObjectId
  booking     Booking       @relation(fields: [bookingId], references: [id])
  type        ChecklistType
  odometerKm  Int?
  fuelLevel   Int?
  notes       String?
  submittedAt DateTime?
  createdAt   DateTime      @default(now())

  photos TripPhoto[]

  @@unique([bookingId, type])
}

model TripPhoto {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  checklistId String        @db.ObjectId
  checklist   TripChecklist @relation(fields: [checklistId], references: [id])
  kind        PhotoKind
  url         String
  createdAt   DateTime      @default(now())
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String        @db.ObjectId
  booking       Booking       @relation(fields: [bookingId], references: [id])
  kind          PaymentKind
  status        PaymentStatus @default(REQUIRES_ACTION)
  amountCents   Int
  currency      String        @default("USD")
  provider      String        @default("mock")
  providerRef   String?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LedgerEntry {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String?    @db.ObjectId
  booking     Booking?   @relation(fields: [bookingId], references: [id])
  ownerId     String?    @db.ObjectId
  payoutId    String?    @db.ObjectId
  payout      Payout?    @relation(fields: [payoutId], references: [id])
  type        LedgerType
  amountCents Int
  currency    String     @default("USD")
  description String?
  createdAt   DateTime   @default(now())
}

model PayoutBatch {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  status      PayoutStatus @default(PENDING)
  createdById String?      @db.ObjectId
  createdBy   User?        @relation("PayoutBatchCreator", fields: [createdById], references: [id])
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime     @default(now())

  payouts Payout[]
}

model Payout {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  batchId     String?      @db.ObjectId
  batch       PayoutBatch? @relation(fields: [batchId], references: [id])
  ownerId     String       @db.ObjectId
  owner       OwnerProfile @relation(fields: [ownerId], references: [id])
  amountCents Int
  currency    String       @default("USD")
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  ledgerEntries LedgerEntry[]
}

model Claim {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String      @unique @db.ObjectId
  booking       Booking     @relation(fields: [bookingId], references: [id])
  vehicleId     String      @db.ObjectId
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  status        ClaimStatus @default(OPEN)
  summary       String
  evidenceUrls  String      @default("[]")
  estimateCents Int?
  policeReport  Boolean     @default(false)
  resolution    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SupportTicket {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String?        @db.ObjectId
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  requesterId String         @db.ObjectId
  requester   User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId  String?        @db.ObjectId
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String        @db.ObjectId
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  authorId  String        @db.ObjectId
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}

model FeeConfig {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  city                  String   @unique
  currency              String   @default("USD")
  ownerShareBps         Int      @default(7000)
  platformFeeBps        Int      @default(3000)
  defaultDepositCents   Int      @default(50000)
  minRenterAge          Int      @default(21)
  softHoldHours         Int      @default(2)
  cancelFullRefundHours Int      @default(48)
  payoutHoldHours       Int      @default(48)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metaJson   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
